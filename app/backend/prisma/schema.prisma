// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// USUÁRIOS E AUTENTICAÇÃO


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  meliponario Meliponario?
  colonias    Colonia[]
  parametros  Parametro[]

  @@map("users")
}


// MELIPONÁRIO


model Meliponario {
  id        String      @id @default(uuid())
  nome      String
  endereco  String?
  cidade    String?
  estado    String?
  latitude  Float?
  longitude Float?
  bioma     String?
  areaTotal Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meliponarios")
}


// COLÔNIAS


model Colonia {
  id               String       @id @default(uuid())
  codigo           String    // TETang-001, MELquaqua-001
  especiePopular   String    // Jataí, Mandaçaia
  especieCientifica String?   // Tetragonisca angustula, Melipona quadrifasciata quadrifasciata
  dataEntrada      DateTime
  origem           String    // captura, compra, divisao, resgate
  tipoCaixa        String    // INPA, PNN, Schenck, tronco, outro
  dimensoesCaixa   String?   // JSON: {altura: 20, largura: 15, ...}
  localizacao      String?   // Local no meliponário
  latitude         Float?
  longitude        Float?
  observacoes      String?   @db.Text
  status           String    @default("ativa") // ativa, inativa (vendida, trocada, etc.), morta
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relações
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  avaliacoes  Avaliacao[]
  fotos       Foto[]
  producoes   Producao[]
  
  // Genealogia
  coloniaMaeId     String?
  coloniaMae       Colonia?  @relation("Genealogia", fields: [coloniaMaeId], references: [id], onDelete: SetNull)
  coloniasFilhas   Colonia[] @relation("Genealogia")

  @@unique([userId, codigo]) // Código único por usuário
  @@index([userId])
  @@index([status])
  @@map("colonias")
}

// PARÂMETROS PERSONALIZÁVEIS

model Parametro {
  id            String      @id @default(uuid())
  nome          String   // "População", "Potes de Mel"
  ordem         Int      @default(0)
  criterioBom   String   @db.Text
  criterioMedio String @db.Text
  criterioRuim  String  @db.Text
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  avaliacoesParametros AvaliacaoParametro[]

  @@unique([userId, nome])
  @@index([userId, ativo])
  @@map("parametros")
}

// AVALIAÇÕES

model Avaliacao {
  id                String      @id @default(uuid())
  dataAvaliacao     DateTime
  duracaoMinutos    Int?
  temperatura       Float?
  umidade           Float?
  condicaoClimatica String?  // ensolarado, nublado, chuvoso
  observacoesGerais String?  @db.Text
  acoesTomadas      String?  @db.Text // JSON array
  scoreGeral        Int      // 0-100
  statusGeral       String   // excelente, boa, atencao, critica
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relações
  coloniaId String
  colonia   Colonia @relation(fields: [coloniaId], references: [id], onDelete: Cascade)

  parametros AvaliacaoParametro[]
  fotos      Foto[]

  @@index([coloniaId])
  @@index([dataAvaliacao])
  @@map("avaliacoes")
}

// AVALIAÇÃO DE PARÂMETROS (N:N)

model AvaliacaoParametro {
  id            String      @id @default(uuid())
  classificacao String   // bom, medio, ruim
  valorNumerico Int?     // Opcional: valor numérico se houver
  observacoes   String?  @db.Text
  createdAt     DateTime @default(now())

  // Relações
  avaliacaoId String
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  parametroId String
  parametro   Parametro @relation(fields: [parametroId], references: [id], onDelete: Cascade)

  fotos Foto[]

  @@unique([avaliacaoId, parametroId])
  @@index([avaliacaoId])
  @@index([parametroId])
  @@map("avaliacoes_parametros")
}

// FOTOS

model Foto {
  id          String      @id @default(uuid())
  url         String   
  legenda     String?
  tamanhoKb   Int?
  createdAt   DateTime @default(now())

  // Relações (pode estar associada a colônia, avaliação ou parâmetro)
  coloniaId String?
  colonia   Colonia? @relation(fields: [coloniaId], references: [id], onDelete: Cascade)

  avaliacaoId String?
  avaliacao   Avaliacao? @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  avaliacaoParametroId String?
  avaliacaoParametro   AvaliacaoParametro? @relation(fields: [avaliacaoParametroId], references: [id], onDelete: Cascade)

  @@index([coloniaId])
  @@index([avaliacaoId])
  @@map("fotos")
}

// PRODUÇÃO E COLHEITAS

model Producao {
  id             Int      @id @default(autoincrement())
  dataColheita   DateTime
  volumeMl       Float    // Volume em mililitros
  tipoProduto    String   // mel, polen, propolis, cera
  caracteristicas String? @db.Text // JSON:
  observacoes    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relações
  coloniaId String
  colonia   Colonia @relation(fields: [coloniaId], references: [id], onDelete: Cascade)

  @@index([coloniaId])
  @@index([dataColheita])
  @@map("producoes")
}

// SINCRONIZAÇÃO OFFLINE

model SyncQueue {
  id          String   @id @default(uuid())
  tipo        String   // avaliacao, colonia, producao
  operacao    String   // create, update, delete
  dados       String   @db.Text // JSON
  tentativas  Int      @default(0)
  ultimoErro  String?  @db.Text
  sincronizado Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sincronizado])
  @@map("sync_queue")
}
